<!DOCTYPE html>
<html lang="pt-br">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>WiFi Turbo Control</title>

<style>
body {
    margin:0;
    font-family: Arial;
    background: linear-gradient(135deg,#1f1c2c,#928dab);
    color:white;
}

/* HEADER */
header {
    text-align:center;
    padding:20px;
    font-size:26px;
    font-weight:bold;
}

/* PLANOS */
.container {
    display:flex;
    justify-content:center;
    flex-wrap:wrap;
    gap:15px;
    padding:20px;
}

.card {
    background: rgba(255,255,255,0.1);
    backdrop-filter: blur(10px);
    border-radius:15px;
    padding:20px;
    width:200px;
    text-align:center;
}

.btn {
    background:#00c6ff;
    border:none;
    padding:10px;
    color:white;
    border-radius:10px;
    cursor:pointer;
}

/* USO */
.usage {
    margin-top:10px;
}

.bar {
    height:10px;
    background:#333;
    border-radius:10px;
    overflow:hidden;
}

.bar div {
    height:100%;
    background:#00ff88;
    width:100%;
}

/* ADMIN */
.admin {
    background:black;
    padding:15px;
    margin:20px;
    border-radius:10px;
}

input {
    padding:8px;
    border-radius:5px;
    border:none;
    margin:5px;
}
</style>
</head>

<body>

<header>📶 WiFi Turbo Pré-Pago</header>

<div class="container" id="plans"></div>

<!-- ADMIN -->
<div class="admin">
<h3>Painel Admin</h3>
<input id="idUser" placeholder="ID usuário">
<input id="addMB" placeholder="Adicionar consumo MB">
<button onclick="consume()">Consumir</button>
</div>

<script>

// PLANOS
const plans = [
{speed:"100 Mbps", price:10, total:1000},
{speed:"150 Mbps", price:20, total:1500},
{speed:"200 Mbps", price:30, total:2000}
];

// STORAGE
let users = JSON.parse(localStorage.getItem("wifiUsers")) || [];

// GERAR PLANOS
const container = document.getElementById("plans");

function render(){
    container.innerHTML="";

    plans.forEach((plan,i)=>{
        container.innerHTML += `
        <div class="card">
            <h3>${plan.speed}</h3>
            <p>R$ ${plan.price}</p>
            <button class="btn" onclick="buy(${i})">Comprar</button>
        </div>`;
    });

    users.forEach(user=>{
        let percent = (user.used / user.total)*100;
        if(percent>100) percent=100;

        container.innerHTML += `
        <div class="card">
            <h3>ID: ${user.id}</h3>
            <p>${user.speed}</p>
            <div class="usage">
                <div class="bar"><div style="width:${100-percent}%"></div></div>
                <small>${user.used}/${user.total} MB</small>
            </div>
            <p>${user.active ? "🟢 Ativo" : "🔴 Bloqueado"}</p>
        </div>`;
    });
}

render();

// COMPRAR
function buy(index){
    let id = Math.floor(Math.random()*10000);

    let plan = plans[index];

    users.push({
        id:id,
        speed:plan.speed,
        total:plan.total,
        used:0,
        active:true
    });

    save();
    alert("Compra realizada! ID: "+id);
}

// CONSUMO
function consume(){
    let id = document.getElementById("idUser").value;
    let mb = parseInt(document.getElementById("addMB").value);

    let user = users.find(u=>u.id==id);

    if(!user) return alert("Usuário não encontrado");

    if(!user.active) return alert("Plano já bloqueado");

    user.used += mb;

    if(user.used >= user.total){
        user.active = false;
        alert("Plano encerrado!");
    }

    save();
}

// SALVAR
function save(){
    localStorage.setItem("wifiUsers", JSON.stringify(users));
    render();
}

</script>

</body>
</html>
